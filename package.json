{
  "name": "playwrightassessment",
  "version": "1.0.0",
  "description": "OrangeHRM automation using Playwright and JavaScript",
  "scripts": {
    "test": "playwright test",
    "test:qa": "cross-env TEST_ENV=qa playwright test",
    "test:stage": "cross-env TEST_ENV=stage playwright test",
    "test:prod": "cross-env TEST_ENV=prod playwright test --grep @smoke",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report"
  },
  "author": "Gokul H S",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5"
  }
}
